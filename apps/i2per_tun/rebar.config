%% The Rust NIF is built by scripts/build-i2per-tun-nif.sh (see there for why
%% a missing cargo skips and a failing cargo fails). The `linux` filter is the
%% platform decision from D3750BZ stated structurally: macOS utun and Windows
%% Wintun are out of scope for 0.8.0, so on those systems the hook does not
%% run at all rather than running and failing.
{pre_hooks, [{"linux", compile, "bash ../../scripts/build-i2per-tun-nif.sh"}]}.

{eunit_opts, [verbose]}.
