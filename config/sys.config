%% Default sys.config shipped inside the release tarball.
%% An operator's provisioning step overwrites this at install time with the
%% deployment's real values (IP, cookie, data dir), so what you see here is
%% the standalone release profile.
[
    {i2per, [
        %% A persistent listen boot requires both data_dir and seeds in the
        %% application environment. An empty seed list is valid; the operator
        %% must explicitly edit this file to opt into live participation.
        {data_dir, "./data"},
        {seeds, []},
        {host, <<"127.0.0.1">>},
        {port, 9150},
        {allow_private_host, true},
        {ntcp2_published, false},
        {transit_max_tunnels, 10},
        {transit_bandwidth_kbps, 64},
        {tunnel_build_rate, 1},
        {max_ntcp2_connections, 64},
        {max_sam_sessions, 32},
        {max_ssu2_sessions, 32},
        {live_network, false}
        %% Live participation is opt-in. Set live_network = true (and
        %% [reseed] enabled = true) in this file when joining I2P.
        %%
        %% NetDb housekeeping. Uncomment to retune; the defaults below are what
        %% ships.
        %%
        %% How often the store is written to disk. 15 minutes.
        %% {netdb_autosave_ms, 900000},
        %%
        %% How often expired entries are swept out. 30 minutes.
        %% {netdb_expiry_ms, 1800000},
        %%
        %% The two ends of the RouterInfo expiry horizon, in ms. The horizon in
        %% force slides between them as the store fills (i2pd's rule: 27h at 90
        %% routers, about 1h57m at this router's 5000-router capacity), so neither
        %% number alone is the policy and both are reported by `i2per_status`.
        %%
        %% These are i2pd's own two ends. Raising the ceiling helps a router that
        %% has just booted and holds few routers; lowering the floor is what a
        %% router at capacity wants. Set them to the same value for a flat horizon
        %% that never slides.
        %%
        %% At this router's 5000-router capacity the curve sits at 1h57m32s.
        %%
        %% {netdb_expiration_ms, 97200000},
        %% {netdb_expiration_min_ms, 5400000}
        %%
        %% A netdb file written under a longer horizon is loaded in full and
        %% compacted at the next sweep rather than on boot, so retuning these keys
        %% never costs the whole store at once.
    ]},
    %% Erlang distribution for operator access (`bin/i2per eval`/`rpc`):
    %% epmd 4369 + this listen range must be reachable from the operator.
    %%
    %% `logger_level` and the `logger` section are the logging floor (ADR 0002).
    %% Stdout, and stdout only. Both live under `kernel` rather than at top level,
    %% and neither is shaped the way the documentation for older OTP suggests --
    %% both facts established by booting `erl -config config/sys.config` and
    %% reading the refusal, not by reading the manual:
    %%
    %%   - the primary level comes from `kernel`/`logger_level`. A `{level, notice}`
    %%     entry *inside* the `logger` section is refused by
    %%     `logger:check_logger_config/2`, which takes the whole node down with
    %%     `{bad_config, {kernel, [{level, notice}]}}`.
    %%
    %% The level is in force from boot until `m:i2per_app:start/2` applies the
    %% `log_level` key, so it governs the window in which the kernel, stdlib and
    %% the config loader report. It must stay equal to `m:i2p_log:default_level/0`
    %% and a test in `i2p_log_tests` pins the two together: a file that drifts from
    %% the code is a release whose stated default is not the one it starts at.
    {kernel, [
        {logger_level, notice},
        {logger, [
            %% The handler carries no `level`. It inherits `logger_level`, which is
            %% deliberate: `log_level` is the single verbosity control, and a second
            %% knob here would be a second place to set it with no way to tell which
            %% one won.
            {handler, default, logger_std_h, #{
                %% The formatter is named rather than left to OTP's default, because a
                %% default that can change between OTP releases is not a default an
                %% operator's log parsing can rely on.
                formatter => {logger_formatter, #{
                    single_line => true,
                    template => [time, " ", level, " ", mfa, ": ", msg, "\n"]}},
                %% `standard_io` and not `standard_error`: the shipped `default`
                %% handler *is* `standard_io`, and switching it is refused as an
                %% `{illegal_config_change, logger_std_h, ...}` at boot.
                config => #{type => standard_io}
            }}
        ]},
        {inet_dist_listen_min, 43690},
        {inet_dist_listen_max, 43699}
    ]}
].

%% ---------------------------------------------------------------------
%% A file handler, commented out.
%%
%% Not shipped enabled. A foreground release is already rotated by whatever
%% supervises it, and *where* the log goes, *how large* it may get and *who*
%% prunes it are deployment decisions in the deployment repository (ADR 0001).
%% The core is not in a position to choose a size cap it cannot know, so the
%% number below is a placeholder to be replaced, not a recommendation: pick
%% `max_log_size` for the operator's disk, and pick something that prunes.
%%
%% To enable, replace the `default` handler entry above with this one.
%%
%% {handler, file, logger_std_h, #{
%%     formatter => {logger_formatter, #{
%%         single_line => true,
%%         template => [time, " ", level, " ", mfa, ": ", msg, "\n"]}},
%%     config => #{
%%         type => file,
%%         file => "/var/log/i2per/i2per.log",
%%         %% 10 MiB. THE OPERATOR'S NUMBER -- see above.
%%         max_log_size => 10485760,
%%         filesync_repeat_interval => 5000
%%     }
%% }}