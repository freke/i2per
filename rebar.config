{erl_opts, [debug_info, warnings_as_errors]}.

%% rebar3_ex_doc stays a project_plugin purely as the provider of the bundled
%% ExDoc escript used by scripts/gen-docs.sh (see `just doc`). ExDoc config now
%% lives in docs/docs.exs.
{project_plugins, [rebar3_ex_doc]}.

{cover_opts, [verbose]}.

{eunit_opts, [verbose]}.

%% Start the router when `just shell` opens an interactive rebar3 shell.
{shell, [{apps, [i2per]}]}.

%% Common Test: the `suite` list opts out of auto-discovery, so `rebar3 ct`
%% (via `just check`) runs exactly these deterministic suites. The gated
%% i2pd-interop suite (apps/i2per/test/i2p_i2pd_interop_SUITE.erl) lives in
%% the same dir but is deliberately excluded here — it needs a live external
%% i2pd and is run only by scripts/interop_i2pd.sh, whose `rebar3 ct --suite`
%% overrides this list (any CLI test selector replaces all config selectors).
%% Keep this list in sync when adding or removing a Common Test suite.
%% Each test case gets its own fresh process and mailbox (no shared eunit_proc
%% pollution) and its own priv_dir, created on demand. The justfile CT recipes
%% pass `--sname i2per_ct`, so the whole CT run node is dist-enabled from the
%% start (apps/i2per_status/test/i2per_status_SUITE.erl spawns a `peer` router
%% node that cannot join a non-distributed node); the EUnit run stays
%% `nonode@nohost` because `-sname` is a CT-only CLI flag, never a config-level
%% dist_node. Suites bind listen sockets at port 0 and let the kernel assign
%% ephemeral ports.
{ct_opts, [
    {
        suite,
        [
            "apps/i2per/test/i2p_ntcp2_conn_SUITE",
            "apps/i2per/test/i2p_ssu2_e2e_SUITE",
            "apps/i2per/test/i2p_ssu2_peertest_SUITE",
            "apps/i2per/test/i2p_ssu2_relay_SUITE",
            "apps/i2per/test/i2p_ssu2_handshake_SUITE",
            "apps/i2per/test/i2p_peer_transport_SUITE",
            "apps/i2per/test/i2p_peer_discovery_SUITE",
            "apps/i2per/test/i2p_netdb_srv_SUITE",
            "apps/i2per/test/i2p_reseed_srv_SUITE",
            "apps/i2per/test/i2p_config_srv_SUITE",
            "apps/i2per/test/i2p_addressbook_SUITE",
            "apps/i2per/test/i2p_server_tunnel_SUITE",
            "apps/i2per/test/i2p_lookup_srv_SUITE",
            "apps/i2per/test/i2p_stream_conn_SUITE",
            "apps/i2per/test/i2p_peer_rep_SUITE",
            "apps/i2per/test/i2p_peer_blocks_SUITE",
            "apps/i2per/test/i2p_floodfill_SUITE",
            "apps/i2per/test/i2p_tunnel_srv_exploratory_SUITE",
            "apps/i2per/test/i2p_tunnel_srv_SUITE",
            "apps/i2per/test/i2p_sam_SUITE",
            "apps/i2per/test/i2p_sam_datagram_SUITE",
            "apps/i2per/test/i2p_boot_SUITE",
            "apps/i2per_status/test/i2per_status_SUITE"
        ]
    },
    {create_priv_dir, auto_per_tc}
]}.

{dialyzer, [{warnings, [unmatched_returns, error_handling, underspecs]}]}.

{profiles, [
    {test, [{erl_opts, [debug_info, nowarn_export_all]}]},
    %% The production release (built by scripts/build-release.sh, `just release`)
    %% is a relx tarball with ERTS included, `-mode embedded`, and the
    %% extended release script for operator commands. `i2per_status` stays out
    %% on purpose; the status service runs on the operator host. The shipped
    %% config/sys.config and config/vm.args are standalone defaults; an
    %% operator's provisioning step writes deployment-specific values at
    %% install time.
    {prod, [
        {relx, [
            {release, {i2per, "0.1.0"}, [i2per, sasl]},
            %% relx 4.x prod preset: include_erts=true (self-contained tarball),
            %% debug_info=strip, dev_mode=false, include_src=false.
            %% sasl and the extended script provide release commands such as
            %% eval, rpc, and versions. The 0.1.0 artifact does not generate
            %% relups for in-place patching.
            {mode, prod},
            {extended_start_script, true},
            {vm_args, "config/vm.args"},
            {sys_config, "config/sys.config"},
            {overlay, [
                {copy, "LICENSE", "LICENSE"},
                {copy, "NOTICE", "NOTICE"},
                {copy, "README.md", "README.md"},
                {copy, "docs/documentation.md", "docs/documentation.md"},
                {copy, "docs/protocol.md", "docs/protocol.md"}
            ]}
        ]}
    ]}
]}.