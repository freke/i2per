{erl_opts, [debug_info, warnings_as_errors]}.

%% rebar3_ex_doc stays a project_plugin purely as the provider of the bundled
%% ExDoc escript used by scripts/gen-docs.sh (see `just doc`). ExDoc config now
%% lives in docs/docs.exs.
{project_plugins, [rebar3_ex_doc]}.

{cover_opts, [verbose]}.

%% `telemetry` is how a value reaches something that wants it continuously rather
%% than by polling `f:i2p_status_data:view/0`. One event is emitted today -- the
%% bus backlog, from `f:i2p_events:sample_backlog/0` -- and nothing in this tree
%% attaches to it yet.
%%
%% **It is the seam, not a feature.** The alternative was a `webapp` polling the
%% read API on a timer, which is the same shape with more moving parts: every
%% consumer pays for its own timer, and a value sampled at read time is already
%% stale by the time it is rendered. Attaching to an event is the observer-tool
%% model, scoped to what this router actually reports.
%%
%% The cost is a dependency and one `f:telemetry:execute/3` per sample, which with
%% no handler attached is close to free.
{deps, [telemetry]}.

{eunit_opts, [verbose]}.

%% Start the router when `just shell` opens an interactive rebar3 shell.
{shell, [{apps, [i2per]}]}.

%% Common Test: suites are auto-discovered, so `rebar3 ct` (via `just check`)
%% runs every `*_SUITE.erl` under an app's `test/` directory. There is no list
%% here to keep in sync with the tree, which is the point: a hand-maintained
%% list is a second copy of the suite set, and a suite added to disk but
%% forgotten in the list runs never while the gate stays green.
%%
%% The gated i2pd-interop suite therefore does not live in `test/`. It is at
%% apps/i2per/interop/i2p_i2pd_interop_SUITE.erl, a directory rebar3 does not
%% discover, and is run only by scripts/interop_i2pd.sh. Its exclusion from
%% `just check` is structural rather than a line someone has to remember, and a
%% CLI `--suite` still reaches it because it compiles on demand.
%%
%% Each test case gets its own fresh process and mailbox (no shared eunit_proc
%% pollution) and its own priv_dir, created on demand. The justfile CT recipes
%% pass `--sname i2per_ct`, so the whole CT run node is dist-enabled from the
%% start (apps/i2per_status/test/i2per_status_SUITE.erl spawns a `peer` router
%% node that cannot join a non-distributed node); the EUnit run stays
%% `nonode@nohost` because `-sname` is a CT-only CLI flag, never a config-level
%% dist_node. Suites bind listen sockets at port 0 and let the kernel assign
%% ephemeral ports.
{ct_opts, [{create_priv_dir, auto_per_tc}]}.

%% `plt_extra_apps` is here because the core calls `f:telemetry:execute/3`. The
%% PLT is built from this project's own applications, so a dep the core calls into
%% is "unknown function" to dialyzer and the gate fails on a call that is perfectly
%% well-typed -- a gate that reports a lie is worse than an absent one.
{dialyzer, [
    {warnings, [unmatched_returns, error_handling, underspecs]},
    {plt_extra_apps, [telemetry]}
]}.

{profiles, [
    {test, [{erl_opts, [debug_info, nowarn_export_all]}]},
    %% The production release (built by scripts/build-release.sh, `just release`)
    %% is a relx tarball with ERTS included, `-mode embedded`, and the
    %% extended release script for operator commands. `i2per_status` stays out
    %% on purpose; the status service runs on the operator host. The shipped
    %% config/sys.config and config/vm.args are standalone defaults; an
    %% operator's provisioning step writes deployment-specific values at
    %% install time.
    {prod, [
        {relx, [
            {release, {i2per, "0.2.0"}, [i2per, sasl]},
            %% relx 4.x prod preset: include_erts=true (self-contained tarball),
            %% debug_info=strip, dev_mode=false, include_src=false.
            %% sasl and the extended script provide release commands such as
            %% eval, rpc, and versions. The 0.1.0 artifact does not generate
            %% relups for in-place patching.
            {mode, prod},
            {extended_start_script, true},
            {vm_args, "config/vm.args"},
            {sys_config, "config/sys.config"},
            {overlay, [
                {copy, "LICENSE", "LICENSE"},
                {copy, "NOTICE", "NOTICE"},
                {copy, "README.md", "README.md"},
                {copy, "docs/documentation.md", "docs/documentation.md"},
                {copy, "docs/protocol.md", "docs/protocol.md"}
            ]}
        ]}
    ]}
]}.